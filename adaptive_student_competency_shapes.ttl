@prefix ex: <https://example.org/adaptive-student-competency-model#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Примечание по GoalShape:
# Правило «каждая цель связана ровно с одним студентом» сохранено в OWL TBox
# исходного RDF через owl:qualifiedCardinality 1 по обратному свойству.
# В используемой конфигурации Ontosphere SHACL Core inversePath дал ложное
# нарушение, а sh:sparql привёл к SPARQLConstraintComponent error.
# Поэтому это правило проверяется отдельным обычным SPARQL SELECT-запросом,
# который приложен в goal_student_count.rq. Классы и свойства модели не меняются.

# Если у освоения указан уровень больше 0, оно должно иметь доказательство.
ex:MasteryShape a sh:NodeShape ;
    sh:targetClass ex:CompetenceMastery ;
    sh:or (
        [
            sh:property [
                sh:path ex:competenceMasteryLevel ;
                sh:maxInclusive 0
            ]
        ]
        [
            sh:property [
                sh:path ex:competenceMasteryProvesEvidence ;
                sh:minCount 1
            ]
        ]
    ) ;
    sh:message "Освоение с уровнем больше 0 должно иметь хотя бы одно доказательство."@ru .

# Каждое требование роли указывает ровно на одну компетенцию.
ex:RoleRequirementShape a sh:NodeShape ;
    sh:targetClass ex:RoleRequirement ;
    sh:property [
        sh:path ex:roleRequirementRequiresCompetence ;
        sh:class ex:Competence ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

# Каждая профессиональная роль имеет хотя бы одно требование.
ex:RoleShape a sh:NodeShape ;
    sh:targetClass ex:ProfessionalRole ;
    sh:property [
        sh:path ex:professionalRoleHasRequirement ;
        sh:class ex:RoleRequirement ;
        sh:minCount 1
    ] .

# Каждая траектория развития содержит хотя бы один шаг.
ex:TrajectoryShape a sh:NodeShape ;
    sh:targetClass ex:DevelopmentTrajectory ;
    sh:property [
        sh:path ex:developmentTrajectoryConsistsOfStep ;
        sh:class ex:TrajectoryStep ;
        sh:minCount 1
    ] .
