@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix match: <https://example.org/match-decision-history#> .

# Минимальные SHACL-проверки для учебного сценария.
# Проверяется только ключевая структура текущего состояния:
# три исторических решения, одно действующее признание,
# последний акт судей и неизменный фактический результат.
# Вложенные sh:node, sh:class, datatype и временные ограничения не используются.

match:MatchScenarioShape
    a sh:NodeShape ;
    sh:targetNode match:match1 ;

    sh:property [
        sh:path match:hasDecision ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        sh:message "В истории матча должно быть ровно три записи о решениях судей."@ru
    ] ;

    sh:property [
        sh:path match:hasCurrentRecognition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue match:decision1_initial ;
        sh:message "Должно быть ровно одно действующее признание — первоначальное решение в пользу команды А."@ru
    ] ;

    sh:property [
        sh:path match:hasLatestDecision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue match:decision3_cancellation ;
        sh:message "Последним актом судей должно быть решение об отмене пересмотренного решения."@ru
    ] .

match:SportingOutcomeShape
    a sh:NodeShape ;
    sh:targetNode match:sportingOutcome1 ;

    sh:property [
        sh:path match:sportingWinner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue match:teamA ;
        sh:message "Фактическим победителем матча должна оставаться команда А."@ru
    ] ;

    sh:property [
        sh:path match:sportingLoser ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue match:teamB ;
        sh:message "Фактически проигравшей командой должна оставаться команда Б."@ru
    ] .
